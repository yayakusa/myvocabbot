<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VocabBot Smart Collector - แฟลชการ์ดภาษาอังกฤษ ป.6</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts - Mali & Itim for Cute Look -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Itim&family=Mali:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Mali', 'Itim', cursive;
            background-color: #f0fdf4; /* Light green/teal pastel background */
        }
        
        /* 3D Card Flip Styling */
        .flashcard-container {
            perspective: 1000px;
        }
        
        .flashcard-inner {
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
        
        .flashcard-container.flipped .flashcard-inner {
            transform: rotateY(180deg);
        }
        
        .card-front, .card-back {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        
        .card-back {
            transform: rotateY(180deg);
        }
        
        /* Sparkle Animation */
        @keyframes bounce-slow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .bounce-element {
            animation: bounce-slow 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-slate-800">

    <!-- Header & Navigation -->
    <header class="bg-gradient-to-r from-teal-400 to-emerald-500 text-white shadow-lg py-4 px-6 sticky top-0 z-50 rounded-b-3xl">
        <div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <!-- Brand -->
            <div class="flex items-center gap-3">
                <div class="bg-white p-2 rounded-full shadow-md text-emerald-600 text-2xl bounce-element">
                    <i class="fa-solid fa-robot"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-wide">VocabBot Smart Collector</h1>
                    <p class="text-xs text-teal-100">นวัตกรรมสะสมศัพท์ภาษาอังกฤษอ้างอิงคลังข้อสอบ ป.6</p>
                </div>
            </div>
            
            <!-- Mascot Selector -->
            <div class="flex items-center gap-2 bg-teal-600 bg-opacity-40 p-1.5 rounded-full border border-teal-300">
                <span class="text-xs font-semibold px-2">เลือกไกด์บอท:</span>
                <button id="btn-faris" onclick="switchMascot('faris')" class="px-3 py-1 rounded-full text-xs font-bold transition-all bg-white text-emerald-700 shadow-md">
                    👦 น้องฟาริส
                </button>
                <button id="btn-aminah" onclick="switchMascot('aminah')" class="px-3 py-1 rounded-full text-xs font-bold transition-all text-white hover:bg-teal-500">
                    👧 น้องอามีนะห์
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl w-full mx-auto p-4 sm:p-6 flex-grow">
        
        <!-- Dashboard & Progress -->
        <section class="bg-white rounded-3xl p-5 mb-6 shadow-md border-2 border-emerald-100 flex flex-col md:flex-row items-center justify-between gap-6">
            <!-- Mascot Character & Balloon Chat -->
            <div class="flex items-center gap-4 w-full md:w-auto">
                <!-- SVG Avatar Container (Changes based on selection) -->
                <div id="mascot-avatar" class="w-24 h-24 flex-shrink-0 bg-teal-50 rounded-2xl border-2 border-teal-200 p-2 flex items-center justify-center shadow-inner relative">
                    <!-- Dynamic SVG will be rendered here by JS -->
                </div>
                <!-- Balloon Chat -->
                <div class="bg-teal-50 border-2 border-teal-100 p-3 rounded-2xl relative flex-grow">
                    <div class="absolute left-0 top-1/2 transform -translate-x-2 -translate-y-1/2 w-0 h-0 border-t-8 border-t-transparent border-r-8 border-r-teal-50 border-b-8 border-b-transparent"></div>
                    <p id="mascot-bubble" class="text-sm font-semibold text-teal-800">
                        อัสลามุอะลัยกุมครับ! ผมคือบอทฟาริส วันนี้มาสะสมคำศัพท์กันนะ! ยิ่งสะสมระดับยิ่งสูงขึ้นนะเพื่อนๆ!
                    </p>
                </div>
            </div>

            <!-- Stats/Collector Info -->
            <div class="bg-gradient-to-br from-emerald-50 to-teal-50 p-4 rounded-2xl border border-emerald-100 w-full md:w-80 shadow-sm">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-sm font-bold text-emerald-800"><i class="fa-solid fa-star text-amber-400 mr-1"></i> ระดับนักสะสม:</span>
                    <span id="collector-badge" class="bg-emerald-600 text-white text-xs px-2 py-0.5 rounded-full font-bold">Vocab Rookie (Lv.1)</span>
                </div>
                <!-- Progress Bar -->
                <div class="w-full bg-slate-200 rounded-full h-3 mb-2 overflow-hidden">
                    <div id="progress-bar" class="bg-gradient-to-r from-teal-400 to-emerald-500 h-full transition-all duration-500" style="width: 0%"></div>
                </div>
                <div class="flex justify-between text-xs text-slate-500 font-bold">
                    <span>สะสมคำศัพท์แล้ว: <span id="collected-count" class="text-emerald-600 font-bold text-sm">0</span> / <span id="total-count">0</span> คำ</span>
                    <span id="progress-percent">0%</span>
                </div>
            </div>
        </section>

        <!-- Filter / Categories -->
        <section class="mb-6">
            <h2 class="text-lg font-bold text-emerald-800 mb-3"><i class="fa-solid fa-tags mr-2"></i> เลือกหมวดหมู่คำศัพท์ตามหลักสูตร ป.6</h2>
            <div class="flex flex-wrap gap-2">
                <button onclick="filterCategory('all')" id="cat-all" class="category-btn active px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-emerald-600 text-white">
                    ทั้งหมด 🌟
                </button>
                <button onclick="filterCategory('body')" id="cat-body" class="category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-white hover:bg-emerald-50 text-emerald-700 border-emerald-100">
                    ร่างกาย/ชีวิต 👃🌱
                </button>
                <button onclick="filterCategory('questions')" id="cat-questions" class="category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-white hover:bg-emerald-50 text-emerald-700 border-emerald-100">
                    หมวดแสดงคำถาม ❓
                </button>
                <button onclick="filterCategory('royal')" id="cat-royal" class="category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-white hover:bg-emerald-50 text-emerald-700 border-emerald-100">
                    คำราชาศัพท์ 👑✨
                </button>
                <button onclick="filterCategory('collected')" id="cat-collected" class="category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-white hover:bg-amber-50 text-amber-700 border-amber-200">
                    คลังสะสมของฉัน 🎒 (<span id="collected-btn-count">0</span>)
                </button>
            </div>
        </section>

        <!-- Flashcard Showcase -->
        <section class="flex flex-col items-center justify-center py-4">
            
            <!-- The Card -->
            <div id="flashcard" class="flashcard-container w-full max-w-md h-85 cursor-pointer">
                <div class="flashcard-inner relative w-full h-full shadow-xl rounded-3xl duration-500">
                    
                    <!-- Card Front (English Word) -->
                    <div class="card-front absolute inset-0 bg-gradient-to-br from-white to-teal-50 border-4 border-teal-300 rounded-3xl flex flex-col justify-between p-6">
                        <!-- Top actions -->
                        <div class="flex justify-between items-center w-full">
                            <span id="card-front-tag" class="bg-teal-100 text-teal-800 text-xs px-3 py-1 rounded-full font-bold">หมวดคำศัพท์</span>
                            <button id="speak-btn" onclick="speakWord(event)" class="bg-teal-500 hover:bg-teal-600 text-white w-10 h-10 rounded-full flex items-center justify-center shadow-md transition-all">
                                <i class="fa-solid fa-volume-high text-lg"></i>
                            </button>
                        </div>
                        
                        <!-- Main English Word -->
                        <div class="text-center my-auto">
                            <h2 id="card-english" class="text-4xl sm:text-5xl font-bold tracking-wide text-slate-800 break-words mb-2"></h2>
                            <p id="card-pos" class="text-sm font-semibold text-teal-600 uppercase italic"></p>
                        </div>
                        
                        <!-- Hint / Flip Hint -->
                        <div class="text-center text-slate-400 text-xs font-bold">
                            <i class="fa-solid fa-arrows-rotate mr-1"></i> คลิกหรือแตะเพื่อพลิกดูคำแปลและคำอ่าน
                        </div>
                    </div>
                    
                    <!-- Card Back (Thai Pronunciation & Translation) -->
                    <div class="card-back absolute inset-0 bg-gradient-to-br from-teal-50 to-emerald-50 border-4 border-emerald-400 rounded-3xl flex flex-col justify-between p-6">
                        <!-- Top actions -->
                        <div class="flex justify-between items-center w-full">
                            <span id="card-back-tag" class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold">คำแปล & เสียงอ่าน</span>
                            <span class="text-emerald-600 text-lg"><i class="fa-solid fa-circle-check"></i></span>
                        </div>
                        
                        <!-- Meaning & Pronunciation -->
                        <div class="text-center my-auto space-y-4">
                            <div>
                                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">คำอ่านสะกดภาษาไทย</p>
                                <h3 id="card-pronunciation" class="text-3xl font-bold text-emerald-700 mt-1"></h3>
                            </div>
                            <div class="border-t border-emerald-100 pt-3">
                                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">ความหมาย / คำแปล</p>
                                <h3 id="card-translation" class="text-2xl font-bold text-slate-800 mt-1"></h3>
                            </div>
                        </div>
                        
                        <!-- Flip Back Hint -->
                        <div class="text-center text-slate-400 text-xs font-bold">
                            <i class="fa-solid fa-arrows-rotate mr-1"></i> พลิกกลับหน้าหลัก
                        </div>
                    </div>

                </div>
            </div>

            <!-- Flashcard Control Panel -->
            <div class="flex items-center gap-4 mt-6 w-full max-w-md justify-between">
                <!-- Prev Button -->
                <button onclick="prevCard()" class="bg-white hover:bg-slate-100 text-emerald-700 border-2 border-emerald-200 w-12 h-12 rounded-full flex items-center justify-center shadow-md transition-all">
                    <i class="fa-solid fa-chevron-left text-lg"></i>
                </button>
                
                <!-- Smart Collect Button -->
                <button id="collect-btn" onclick="toggleCollectCurrent()" class="flex-grow bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold py-3 px-6 rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 border-b-4 border-amber-600 active:border-b-0">
                    <i id="collect-icon" class="fa-regular fa-bookmark text-lg"></i>
                    <span id="collect-text">สะสมคำนี้ลงในคลัง</span>
                </button>
                
                <!-- Next Button -->
                <button onclick="nextCard()" class="bg-white hover:bg-slate-100 text-emerald-700 border-2 border-emerald-200 w-12 h-12 rounded-full flex items-center justify-center shadow-md transition-all">
                    <i class="fa-solid fa-chevron-right text-lg"></i>
                </button>
            </div>
            
            <!-- Index indicator -->
            <p class="text-slate-500 font-semibold text-xs mt-3">คำที่ <span id="current-index">1</span> จากทั้งหมด <span id="filtered-total">10</span> ในหมวดหมู่นี้</p>

        </section>

        <!-- Collector List Showcase (Hidden unless selected or shown) -->
        <section id="collection-showcase" class="bg-white rounded-3xl p-6 mt-6 shadow-md border-2 border-amber-100 hidden">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-amber-800"><i class="fa-solid fa-briefcase mr-2"></i> สมุดสะสมศัพท์อัจฉริยะส่วนตัว</h3>
                <button onclick="clearMyCollection()" class="text-xs text-red-500 hover:text-red-700 font-bold"><i class="fa-solid fa-trash-can mr-1"></i> ล้างคลังคำศัพท์</button>
            </div>
            
            <div id="collected-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <!-- Dynamically generated cute badges of collected words -->
                <div class="col-span-full text-center py-6 text-slate-400 text-sm">
                    คุณยังไม่ได้สะสมคำศัพท์เลย ลองกดปุ่ม "สะสมคำนี้ลงในคลัง" สีเหลืองสิครับ!
                </div>
            </div>
        </section>

        <!-- Quick Game Section -->
        <section class="bg-gradient-to-br from-teal-500 to-emerald-600 rounded-3xl p-6 mt-8 text-white shadow-xl relative overflow-hidden">
            <div class="absolute right-0 bottom-0 opacity-10 text-9xl">
                <i class="fa-solid fa-gamepad"></i>
            </div>
            <div class="relative z-10 max-w-md">
                <span class="bg-teal-400 text-teal-950 text-xs px-2.5 py-1 rounded-full font-black uppercase tracking-wider">ภารกิจฝึกใช้งานจริง!</span>
                <h3 class="text-2xl font-bold mt-2 mb-1">🎮 มินิเกมทดสอบสมองประลองศัพท์</h3>
                <p class="text-sm text-teal-100 mb-4">มาช่วยกันตอบคำถามท้าทายจาก VocabBot เพื่อทบทวนการเรียนรู้อย่างยั่งยืนกันครับ!</p>
                <button onclick="startMiniGame()" class="bg-white hover:bg-amber-100 text-emerald-800 font-black py-3 px-6 rounded-2xl shadow-lg transition-all text-sm inline-flex items-center gap-2">
                    <i class="fa-solid fa-play"></i> เริ่มเล่นมินิเกมด่วน!
                </button>
            </div>
        </section>

    </main>

    <!-- Mini Game Modal (Simple Pop Up Quiz) -->
    <div id="game-modal" class="fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden border-4 border-teal-400 flex flex-col">
            <!-- Modal Header -->
            <div class="bg-teal-500 text-white p-4 flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-300 text-lg"></i>
                    <span class="font-bold">VocabBot Quiz Game!</span>
                </div>
                <button onclick="closeMiniGame()" class="text-white hover:text-red-200 text-xl font-bold">&times;</button>
            </div>
            
            <!-- Modal Body -->
            <div class="p-6 flex-grow flex flex-col justify-between min-h-[300px]">
                <div id="quiz-question-area" class="text-center space-y-4">
                    <span class="text-xs bg-teal-50 text-teal-800 border border-teal-200 px-3 py-1 rounded-full font-bold">คำถามทบทวน</span>
                    <h4 id="quiz-word" class="text-3xl font-black text-slate-800">🍎 Word</h4>
                    <p class="text-slate-500 text-sm">แปลว่าอะไรเอ่ย? จับคู่คำศัพท์ให้ถูกต้องนะ!</p>
                </div>
                
                <!-- Options Grid -->
                <div id="quiz-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-6">
                    <!-- Buttons dynamic insertion -->
                </div>
                
                <!-- Feedback Status -->
                <div id="quiz-feedback" class="text-center py-2 font-bold text-emerald-600 hidden">
                    🎉 ถูกต้องเก่งมากเลย!
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-800 text-slate-400 py-6 text-center text-xs mt-10 border-t border-slate-700">
        <p class="font-bold text-slate-300">VocabBot Smart Collector © 2026</p>
        <p class="mt-1">พัฒนาเพื่อส่งเสริม Best Practice การเรียนรู้คำศัพท์ภาษาอังกฤษระดับชั้นประถมศึกษาปีที่ 6</p>
    </footer>

    <!-- Scripting for application behavior -->
    <script>
        // Exact words from the uploaded P.6 Vocab PDF
        const vocabularyData = [
            // Category: Body / Life (หมวด ร่างกาย / อวัยวะ / เพศ)
            { id: 1, english: "live", pos: "คุณศัพท์", pronunciation: "ไลฝ", translation: "มีชีวิต, เป็นๆ", category: "body" },
            { id: 2, english: "die", pos: "คำนาม", pronunciation: "ได", translation: "ตาย, สูญสิ้น", category: "body" },
            { id: 3, english: "death", pos: "คำนาม", pronunciation: "เด็ธ", translation: "ความตาย, แน่นิ่ง", category: "body" },
            { id: 4, english: "body", pos: "คำนาม", pronunciation: "บอดิ", translation: "ร่างกาย, ลำตัว", category: "body" },
            { id: 5, english: "shape", pos: "คำนาม", pronunciation: "เฌพ", translation: "รูปร่าง, ทรวดทรง", category: "body" },
            { id: 6, english: "hair", pos: "คำนาม", pronunciation: "แฮ", translation: "ผม, ขน", category: "body" },
            { id: 7, english: "head", pos: "คำนาม", pronunciation: "เฮ็ด", translation: "หัว", category: "body" },
            { id: 8, english: "eye", pos: "คำนาม", pronunciation: "อาย", translation: "ตา", category: "body" },
            { id: 9, english: "eyelash", pos: "คำนาม", pronunciation: "อายแล็ฌ", translation: "ขนตา, แส้", category: "body" },
            { id: 10, english: "brow", pos: "คำนาม", pronunciation: "บราว", translation: "หน้าผาก", category: "body" },

            // Category: Royal Words (ราชาศัพท์)
            { id: 11, english: "Coronation", pos: "คำนาม", pronunciation: "คอระเนเชิน", translation: "พิธีราชาภิเษก", category: "royal" },
            { id: 12, english: "Reign", pos: "คำนาม", pronunciation: "เรน", translation: "รัชกาล รัชสมัย", category: "royal" },
            { id: 13, english: "Court", pos: "คำนาม", pronunciation: "คอร์ท", translation: "พระราชสำนัก", category: "royal" },
            { id: 14, english: "Accede", pos: "คำนาม", pronunciation: "แอคซีด", translation: "ขึ้นครองราชย์", category: "royal" },
            { id: 15, english: "Royal family", pos: "คำนาม", pronunciation: "รอยเอิล-แฟมมิลี", translation: "ราชวงศ์", category: "royal" },
            { id: 16, english: "His Majesty", pos: "คำนาม", pronunciation: "ฮีส-แมจเจสที", translation: "พระบาทสมเด็จพระเจ้าอยู่หัว", category: "royal" },
            { id: 17, english: "The Queen", pos: "คำนาม", pronunciation: "เดอะ-ควีน", translation: "พระราชินี", category: "royal" },

            // Category: Questions (หมวดแสดงคำถาม)
            { id: 18, english: "who", pos: "คำนาม", pronunciation: "ฮุ", translation: "ใคร", category: "questions" },
            { id: 19, english: "what", pos: "คำนาม", pronunciation: "ว็อท", translation: "อะไร", category: "questions" },
            { id: 20, english: "where", pos: "คำนาม", pronunciation: "แว", translation: "ที่ไหน", category: "questions" },
            { id: 21, english: "when", pos: "คำนาม", pronunciation: "เว็น", translation: "เมื่อไหร่", category: "questions" },
            { id: 22, english: "why", pos: "คำนาม", pronunciation: "วาย", translation: "ทำไม", category: "questions" },
            { id: 23, english: "How often", pos: "คำนาม", pronunciation: "ฮาว ออฟเฟิน", translation: "บ่อยแค่ไหน", category: "questions" },
            { id: 24, english: "How far", pos: "คำนาม", pronunciation: "ฮาว ฟา", translation: "ไกลแค่ไหน", category: "questions" },
            { id: 25, english: "How much", pos: "คำนาม", pronunciation: "ฮาว มัส", translation: "ราคาเท่าไร", category: "questions" },
            { id: 26, english: "Whom", pos: "คำนาม", pronunciation: "ฮูม", translation: "ใคร (ทำหน้าที่เป็นกรรม)", category: "questions" },
            { id: 27, english: "How long", pos: "คำนาม", pronunciation: "ฮาว ลอง", translation: "นานแค่ไหน", category: "questions" }
        ];

        // State variables
        let currentMascot = 'faris'; // 'faris' or 'aminah'
        let currentCategory = 'all'; // 'all', 'body', 'questions', 'royal', 'collected'
        let filteredList = [...vocabularyData];
        let currentCardIndex = 0;
        let myCollection = []; // Saved card IDs

        // SVG code for mascots
        const farisSVG = `
        <svg viewBox="0 0 100 100" class="w-20 h-20">
            <!-- Robot Body -->
            <rect x="25" y="35" width="50" height="40" rx="10" fill="#a7f3d0" stroke="#047857" stroke-width="3"/>
            <!-- Robot Head -->
            <rect x="30" y="15" width="40" height="30" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="3"/>
            <!-- Kufi Cap (Muslim Boy Cap) -->
            <path d="M 33 16 Q 50 2 67 16 Z" fill="#10b981" stroke="#047857" stroke-width="2" />
            <line x1="37" y1="11" x2="63" y2="11" stroke="#ffffff" stroke-width="2" stroke-dasharray="2 2"/>
            <!-- Robot Ears / Antennas -->
            <rect x="25" y="23" width="5" height="10" rx="2" fill="#0284c7"/>
            <rect x="70" y="23" width="5" height="10" rx="2" fill="#0284c7"/>
            <!-- Glowing Eyes -->
            <circle cx="42" cy="28" r="4" fill="#06b6d4" class="animate-pulse"/>
            <circle cx="58" cy="28" r="4" fill="#06b6d4" class="animate-pulse"/>
            <!-- Smile Display -->
            <path d="M 44 36 Q 50 42 56 36" stroke="#0284c7" stroke-width="2" fill="none" stroke-linecap="round"/>
            <!-- Hero Cape -->
            <path d="M 25 45 L 10 75 L 35 70 Z" fill="#f59e0b" opacity="0.9"/>
            <path d="M 75 45 L 90 75 L 65 70 Z" fill="#f59e0b" opacity="0.9"/>
            <!-- Chest Star Badge -->
            <polygon points="50,45 53,51 59,51 54,55 56,61 50,57 44,61 46,55 41,51 47,51" fill="#f59e0b"/>
        </svg>
        `;

        const aminahSVG = `
        <svg viewBox="0 0 100 100" class="w-20 h-20">
            <!-- Robot Body -->
            <rect x="25" y="38" width="50" height="38" rx="10" fill="#fbcfe8" stroke="#be185d" stroke-width="3"/>
            <!-- Robot Head -->
            <rect x="32" y="18" width="36" height="28" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="3"/>
            <!-- Hijab Structure -->
            <path d="M 28 16 Q 50 5 72 16 Q 77 30 73 45 Q 65 52 50 52 Q 35 52 27 45 Q 23 30 28 16 Z" fill="#ec4899" stroke="#be185d" stroke-width="2" opacity="0.95"/>
            <!-- Inner Hijab Face Framing -->
            <path d="M 34 18 Q 50 14 66 18 Q 68 35 50 44 Q 32 35 34 18 Z" fill="#fdf2f8"/>
            <!-- Glowing Eyes -->
            <circle cx="43" cy="28" r="4" fill="#ec4899"/>
            <circle cx="57" cy="28" r="4" fill="#ec4899"/>
            <!-- Happy Mouth -->
            <path d="M 46 34 Q 50 38 54 34" stroke="#be185d" stroke-width="2" fill="none" stroke-linecap="round"/>
            <!-- Cheek Blush -->
            <circle cx="39" cy="32" r="2" fill="#f472b6" opacity="0.6"/>
            <circle cx="61" cy="32" r="2" fill="#f472b6" opacity="0.6"/>
            <!-- Cute Flower on Hijab -->
            <circle cx="70" cy="18" r="4" fill="#f59e0b"/>
            <circle cx="70" cy="18" r="1.5" fill="#ffffff"/>
        </svg>
        `;

        // Initialize App on DOM Load
        window.onload = function() {
            // Load saved collection from localStorage if exists
            const savedData = localStorage.getItem('vocab_collector_data');
            if(savedData) {
                myCollection = JSON.parse(savedData);
            }
            
            // Set defaults
            document.getElementById('total-count').innerText = vocabularyData.length;
            switchMascot('faris');
            updateCollectorStats();
            filterCategory('all');
            
            // Set up flashcard click logic
            const flashcardElement = document.getElementById('flashcard');
            flashcardElement.addEventListener('click', function(e) {
                // Prevent flip if clicking on interactive buttons
                if(e.target.closest('#speak-btn') || e.target.closest('button')) {
                    return;
                }
                this.classList.toggle('flipped');
            });
        }

        // Mascot Switch logic
        function switchMascot(mascotName) {
            currentMascot = mascotName;
            const btnFaris = document.getElementById('btn-faris');
            const btnAminah = document.getElementById('btn-aminah');
            const avatarContainer = document.getElementById('mascot-avatar');
            const bubble = document.getElementById('mascot-bubble');
            
            if (mascotName === 'faris') {
                btnFaris.className = "px-3 py-1 rounded-full text-xs font-bold transition-all bg-white text-emerald-700 shadow-md";
                btnAminah.className = "px-3 py-1 rounded-full text-xs font-bold transition-all text-white hover:bg-teal-500";
                avatarContainer.innerHTML = farisSVG;
                bubble.innerText = "อัสลามุอะลัยกุมครับ! ผมคือบอทฟาริส ยินดีต้อนรับสู่คลังสะสมคำศัพท์ ป.6 อัจฉริยะนะเพื่อนๆ มาสะสมคำศัพท์เพื่อเพิ่มความรู้กันนะครับ!";
            } else {
                btnAminah.className = "px-3 py-1 rounded-full text-xs font-bold transition-all bg-white text-emerald-700 shadow-md";
                btnFaris.className = "px-3 py-1 rounded-full text-xs font-bold transition-all text-white hover:bg-teal-500";
                avatarContainer.innerHTML = aminahSVG;
                bubble.innerText = "อัสลามุอะลัยกุมค่ะ! ฉันคือบอทอามีนะห์ ยินดีที่ได้ช่วยเด็กๆ ออกเสียงคำศัพท์ค่ะ แตะที่ปุ่มลำโพงเพื่อฟังเสียงสะกดคำที่ถูกต้องกันเลยนะคะ!";
            }
        }

        // Filter categories
        function filterCategory(category) {
            currentCategory = category;
            
            // Update active state of buttons
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.className = "category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-white text-emerald-700 border-emerald-100 hover:bg-emerald-50";
            });
            
            const activeBtn = document.getElementById(`cat-${category}`);
            if (category === 'collected') {
                activeBtn.className = "category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-amber-500 text-white";
                document.getElementById('collection-showcase').classList.remove('hidden');
            } else {
                activeBtn.className = "category-btn px-4 py-2 rounded-2xl text-sm font-bold shadow-sm border-2 border-transparent transition-all bg-emerald-600 text-white";
                document.getElementById('collection-showcase').classList.add('hidden');
            }
            
            // Perform filtering
            if (category === 'all') {
                filteredList = [...vocabularyData];
            } else if (category === 'collected') {
                filteredList = vocabularyData.filter(item => myCollection.includes(item.id));
            } else {
                filteredList = vocabularyData.filter(item => item.category === category);
            }
            
            currentCardIndex = 0;
            renderCard();
            renderCollectionGrid();
        }

        // Render Card Data
        function renderCard() {
            const cardElement = document.getElementById('flashcard');
            cardElement.classList.remove('flipped'); // Reset flip
            
            const filteredTotalSpan = document.getElementById('filtered-total');
            const currentIndexSpan = document.getElementById('current-index');
            
            if (filteredList.length === 0) {
                // Empty state for collection
                document.getElementById('card-english').innerText = "คลังสะสมของคุณว่างเปล่า";
                document.getElementById('card-pos').innerText = "";
                document.getElementById('card-pronunciation').innerText = "-";
                document.getElementById('card-translation').innerText = "กลับสู่หน้าหมวดหมู่อื่นและกดสะสมคำศัพท์เพื่อดูข้อมูลที่นี่!";
                document.getElementById('card-front-tag').innerText = "ว่างเปล่า";
                document.getElementById('card-back-tag').innerText = "ว่างเปล่า";
                
                filteredTotalSpan.innerText = "0";
                currentIndexSpan.innerText = "0";
                
                // Disable speaker & collect
                document.getElementById('speak-btn').style.opacity = "0.5";
                document.getElementById('collect-btn').style.opacity = "0.5";
                return;
            }
            
            document.getElementById('speak-btn').style.opacity = "1";
            document.getElementById('collect-btn').style.opacity = "1";
            
            const currentItem = filteredList[currentCardIndex];
            
            // Set dynamic text
            document.getElementById('card-english').innerText = currentItem.english;
            document.getElementById('card-pos').innerText = currentItem.pos;
            document.getElementById('card-pronunciation').innerText = currentItem.pronunciation;
            document.getElementById('card-translation').innerText = currentItem.translation;
            
            // Format tag translation
            let tagThai = "ทั่วไป";
            if (currentItem.category === 'body') tagThai = "หมวด ร่างกาย/ชีวิต";
            if (currentItem.category === 'questions') tagThai = "หมวดแสดงคำถาม";
            if (currentItem.category === 'royal') tagThai = "หมวดคำราชาศัพท์";
            
            document.getElementById('card-front-tag').innerText = tagThai;
            document.getElementById('card-back-tag').innerText = tagThai;
            
            // Update counts
            currentIndexSpan.innerText = currentCardIndex + 1;
            filteredTotalSpan.innerText = filteredList.length;
            
            // Update collect button status for this card
            updateCollectButton(currentItem.id);
        }

        // Speaking capability using Web Speech API (TTS)
        function speakWord(event) {
            if(event) event.stopPropagation(); // Avoid card flip trigger
            
            if (filteredList.length === 0) return;
            const currentItem = filteredList[currentCardIndex];
            
            if ('speechSynthesis' in window) {
                // Stop any speaking in progress
                window.speechSynthesis.cancel();
                
                const utterance = new SpeechSynthesisUtterance(currentItem.english);
                utterance.lang = 'en-US';
                utterance.rate = 0.82; // Slightly slower for kids to listen clearly
                
                // Change voice character if available
                const voices = window.speechSynthesis.getVoices();
                if (voices.length > 0) {
                    // Try to pick a clear English accent
                    const perfectVoice = voices.find(v => v.lang.startsWith('en-US') && v.name.includes('Google'));
                    if (perfectVoice) utterance.voice = perfectVoice;
                }
                
                window.speechSynthesis.speak(utterance);
                
                // Mascot Bubble speak effect
                const bubble = document.getElementById('mascot-bubble');
                const botName = currentMascot === 'faris' ? 'บอทฟาริส' : 'บอทอามีนะห์';
                bubble.innerText = `${botName} ออกเสียง "${currentItem.english}" แล้วนะครับ! ลองพูดตามช้าๆ นะครับ!`;
            } else {
                alert("เบราว์เซอร์ของคุณไม่สนับสนุนฟังก์ชันการสังเคราะห์เสียงชั่วคราว");
            }
        }

        // Toggle Collection logic
        function toggleCollectCurrent() {
            if (filteredList.length === 0) return;
            const currentItem = filteredList[currentCardIndex];
            const itemIndex = myCollection.indexOf(currentItem.id);
            
            const bubble = document.getElementById('mascot-bubble');
            const botName = currentMascot === 'faris' ? 'บอทฟาริส' : 'บอทอามีนะห์';
            
            if (itemIndex > -1) {
                // Remove
                myCollection.splice(itemIndex, 1);
                bubble.innerText = `ลบคำศัพท์ "${currentItem.english}" ออกจากกระเป๋าสะสมเรียบร้อยแล้วค่ะ!`;
            } else {
                // Add
                myCollection.push(currentItem.id);
                bubble.innerText = `เยี่ยมยอด! บันทึกคำศัพท์ "${currentItem.english}" เข้าระบบคอลเลกชันสำเร็จแล้วครับ!`;
                
                // Simple visual effect
                createCelebration();
            }
            
            // Save to Local Storage
            localStorage.setItem('vocab_collector_data', JSON.stringify(myCollection));
            
            updateCollectButton(currentItem.id);
            updateCollectorStats();
            renderCollectionGrid();
        }

        // Visual Sparkle Celebration Effect
        function createCelebration() {
            const container = document.getElementById('flashcard');
            const sparkle = document.createElement('div');
            sparkle.className = "absolute text-amber-400 text-3xl animate-bounce pointer-events-none z-20";
            sparkle.innerHTML = "⭐✨🎉";
            sparkle.style.top = "-20px";
            container.appendChild(sparkle);
            setTimeout(() => {
                sparkle.remove();
            }, 1000);
        }

        // Update Button View
        function updateCollectButton(id) {
            const isCollected = myCollection.includes(id);
            const collectBtn = document.getElementById('collect-btn');
            const collectIcon = document.getElementById('collect-icon');
            const collectText = document.getElementById('collect-text');
            
            if (isCollected) {
                collectBtn.className = "flex-grow bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 px-6 rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 border-b-4 border-emerald-700 active:border-b-0";
                collectIcon.className = "fa-solid fa-bookmark text-lg text-amber-200";
                collectText.innerText = "สะสมแล้ว! (คลิกเพื่อยกเลิก)";
            } else {
                collectBtn.className = "flex-grow bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold py-3 px-6 rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 border-b-4 border-amber-600 active:border-b-0";
                collectIcon.className = "fa-regular fa-bookmark text-lg";
                collectText.innerText = "สะสมคำนี้ลงในคลัง";
            }
        }

        // Card navigation
        function nextCard() {
            if (filteredList.length === 0) return;
            currentCardIndex = (currentCardIndex + 1) % filteredList.length;
            renderCard();
        }

        function prevCard() {
            if (filteredList.length === 0) return;
            currentCardIndex = (currentCardIndex - 1 + filteredList.length) % filteredList.length;
            renderCard();
        }

        // Global Collector Progression calculation
        function updateCollectorStats() {
            const total = vocabularyData.length;
            const collected = myCollection.length;
            const percentage = Math.round((collected / total) * 100);
            
            document.getElementById('collected-count').innerText = collected;
            document.getElementById('collected-btn-count').innerText = collected;
            document.getElementById('progress-percent').innerText = `${percentage}%`;
            document.getElementById('progress-bar').style.width = `${percentage}%`;
            
            // Badge / Rank System
            let badge = "Vocab Rookie 👶 (Lv.1)";
            if (percentage >= 20 && percentage < 40) badge = "Vocab Explorer 🧭 (Lv.2)";
            if (percentage >= 40 && percentage < 70) badge = "Vocab Ranger 🎒 (Lv.3)";
            if (percentage >= 70 && percentage < 90) badge = "Vocab Master 🧠 (Lv.4)";
            if (percentage >= 90) badge = "Vocab Hero 👑 (Lv.5)";
            
            document.getElementById('collector-badge').innerText = badge;
        }

        // Render My Collection List Block
        function renderCollectionGrid() {
            const grid = document.getElementById('collected-grid');
            if (myCollection.length === 0) {
                grid.innerHTML = `
                <div class="col-span-full text-center py-6 text-slate-400 text-sm">
                    คุณยังไม่ได้สะสมคำศัพท์เลย ลองกดปุ่ม "สะสมคำนี้ลงในคลัง" สีเหลืองสิครับ!
                </div>`;
                return;
            }
            
            grid.innerHTML = "";
            const collectedItems = vocabularyData.filter(item => myCollection.includes(item.id));
            
            collectedItems.forEach(item => {
                const badge = document.createElement('div');
                badge.className = "bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-xl p-3 flex flex-col justify-between transition-all hover:scale-105 shadow-sm";
                badge.innerHTML = `
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-[10px] bg-amber-200 text-amber-900 px-2 py-0.5 rounded-full font-bold uppercase">${item.pos}</span>
                        <button onclick="removeItemFromCollection(event, ${item.id})" class="text-slate-400 hover:text-red-500 transition-colors"><i class="fa-solid fa-circle-xmark"></i></button>
                    </div>
                    <h4 class="font-bold text-slate-800 text-lg">${item.english}</h4>
                    <p class="text-xs text-emerald-700 font-semibold mt-1">🗣️ คำอ่าน: ${item.pronunciation}</p>
                    <p class="text-xs text-slate-500 mt-0.5 truncate">แปล: ${item.translation}</p>
                `;
                grid.appendChild(badge);
            });
        }

        // Helper to remove item directly from collection view
        function removeItemFromCollection(event, id) {
            event.stopPropagation();
            myCollection = myCollection.filter(itemId => itemId !== id);
            localStorage.setItem('vocab_collector_data', JSON.stringify(myCollection));
            
            updateCollectorStats();
            renderCollectionGrid();
            
            // If we are currently in collected category view, re-filter
            if(currentCategory === 'collected') {
                filterCategory('collected');
            } else {
                // Just update button of the active card
                if (filteredList.length > 0 && filteredList[currentCardIndex].id === id) {
                    updateCollectButton(id);
                }
            }
        }

        function clearMyCollection() {
            if(confirm("คุณต้องการล้างประวัติการสะสมทั้งหมดใช่หรือไม่?")) {
                myCollection = [];
                localStorage.setItem('vocab_collector_data', JSON.stringify(myCollection));
                updateCollectorStats();
                filterCategory(currentCategory);
            }
        }

        // SIMPLE MINI GAME LOGIC (Pop up Quiz)
        let quizCurrentWord = null;
        let quizOptions = [];
        
        function startMiniGame() {
            // Select a random vocabulary
            const randomIndex = Math.floor(Math.random() * vocabularyData.length);
            quizCurrentWord = vocabularyData[randomIndex];
            
            // Get 3 incorrect choices
            const otherWords = vocabularyData.filter(item => item.id !== quizCurrentWord.id);
            const shuffledOthers = otherWords.sort(() => 0.5 - Math.random());
            const incorrectChoices = shuffledOthers.slice(0, 3);
            
            // Pool choices and shuffle
            quizOptions = [quizCurrentWord, ...incorrectChoices].sort(() => 0.5 - Math.random());
            
            // Render to Modal UI
            document.getElementById('quiz-word').innerHTML = `🤖 คำศัพท์: <span class="text-emerald-600 underline">${quizCurrentWord.english}</span>`;
            
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = "";
            
            quizOptions.forEach((option, index) => {
                const btn = document.createElement('button');
                btn.className = "quiz-opt-btn bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-800 border-2 border-slate-200 hover:border-emerald-300 font-bold py-3 px-4 rounded-2xl transition-all text-sm text-left flex items-center justify-between";
                btn.innerHTML = `<span>${index + 1}. ${option.translation}</span> <span class="text-xs text-slate-400 font-normal italic">(${option.pos})</span>`;
                btn.onclick = () => checkQuizAnswer(option.id, btn);
                optionsContainer.appendChild(btn);
            });
            
            document.getElementById('quiz-feedback').classList.add('hidden');
            document.getElementById('game-modal').classList.remove('hidden');
        }

        function checkQuizAnswer(selectedId, buttonElement) {
            // Disable all buttons after click
            document.querySelectorAll('.quiz-opt-btn').forEach(btn => btn.disabled = true);
            
            const feedback = document.getElementById('quiz-feedback');
            feedback.classList.remove('hidden');
            
            if (selectedId === quizCurrentWord.id) {
                buttonElement.className = "quiz-opt-btn bg-emerald-500 text-white border-2 border-emerald-600 font-bold py-3 px-4 rounded-2xl transition-all text-sm text-left flex items-center justify-between";
                feedback.innerHTML = "🎉 ถูกต้องแล้วจ้า! ยอดเยี่ยมมากเด็กๆ! 🌟";
                feedback.className = "text-center py-2 font-bold text-emerald-600";
                
                // Auto add to collection as bonus
                if(!myCollection.includes(quizCurrentWord.id)) {
                    myCollection.push(quizCurrentWord.id);
                    localStorage.setItem('vocab_collector_data', JSON.stringify(myCollection));
                    updateCollectorStats();
                    renderCollectionGrid();
                }
            } else {
                buttonElement.className = "quiz-opt-btn bg-red-500 text-white border-2 border-red-600 font-bold py-3 px-4 rounded-2xl transition-all text-sm text-left flex items-center justify-between";
                feedback.innerHTML = `❌ ยังไม่ถูกนะ คำตอบคือ "<b>${quizCurrentWord.translation}</b>"`;
                feedback.className = "text-center py-2 font-bold text-red-500";
            }
            
            // Show Next Question button
            setTimeout(() => {
                const retryBtn = document.createElement('button');
                retryBtn.className = "mt-4 w-full bg-teal-500 hover:bg-teal-600 text-white font-bold py-3 rounded-2xl shadow-md transition-all";
                retryBtn.innerText = "เล่นข้อถัดไป ➡️";
                retryBtn.onclick = startMiniGame;
                
                const optionsContainer = document.getElementById('quiz-options');
                // Remove previous game dynamic elements, insert new quiz triggers
                const modalBody = document.querySelector('#game-modal .p-6');
                // Ensure no duplicates
                const oldNextBtn = modalBody.querySelector('.mt-4');
                if(oldNextBtn) oldNextBtn.remove();
                modalBody.appendChild(retryBtn);
            }, 500);
        }

        function closeMiniGame() {
            document.getElementById('game-modal').classList.add('hidden');
            const modalBody = document.querySelector('#game-modal .p-6');
            const oldNextBtn = modalBody.querySelector('.mt-4');
            if(oldNextBtn) oldNextBtn.remove();
        }
    </script>
</body>
</html>
